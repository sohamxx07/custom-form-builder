PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Database Configuration (MySQL for Production, or SQLite for local development)
# Option A: Full MySQL Connection String (PlanetScale, Railway, Aiven, RDS, etc.)
# DATABASE_URL=mysql://username:password@hostname:3306/database_name

# Option B: Individual MySQL Parameters
# DB_HOST=your-db-host.com
# DB_PORT=3306
# DB_NAME=custom_form_builder
# DB_USER=your_db_username
# DB_PASSWORD=your_db_password
# DB_SSL=true

# Option C: SQLite (used by default if MySQL variables are not provided)
DB_STORAGE=./database.sqlite
